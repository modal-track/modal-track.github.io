extends _template

block variables
  -var varTitle = "Nuestros Servicios"
  -var varDescription = "Servicios de ModalTrack."
  -var varAuthor = "Kevin Prado"

block content
  .mt-main-content.mt-content--our-services
    div.mt-os-hero
      div.mt-os-hero-os
        h1.mt-os-hero__title Nuestros Servicios
        p.mt-os-hero__text Ofrecemos soluciones logísticas integrales, diseñadas para optimizar procesos y maximizar la eficiencia de tu operación. Contamos con una red de transporte terrestre altamente confiable y capacidades especializadas en carga refrigerada, garantizando trazabilidad, temperatura controlada y cumplimiento normativo. Con tecnología avanzada y personal capacitado, aseguramos entregas puntuales y en condiciones óptimas.
        a.mt-btn.mt-hero__btn(href="#") Contáctanos
      img(src="public/assets/images/our-services/our-services-1.jpg", alt="camiones y contenedores", class="mt-os-hero__image")
    div.mt-slider-container
      div.mt-os-card-grid
        div.mt-os-card-grid__item
          h2.mt-os-card-grid__title Contenedores
          p.mt-os-card-grid__text Especialistas en transporte de contenedores de 20 y 40 pies, refrigerados y secos, con presencia en las principales terminales portuarias del país.
          img(src="public/assets/images/our-services/containers.svg", alt="Contenedores", class="mt-os-hero__logo")
        div.mt-os-card-grid__item
          h2.mt-os-card-grid__title Cargas refrigeradas
          p.mt-os-card-grid__text Contamos con equipos Thermo King para refrigeración y congelación en diversas operaciones.
          img(src="public/assets/images/our-services/refrigerated-loads.svg", alt="Cargas refrigeradas", class="mt-os-hero__logo")
        div.mt-os-card-grid__item
          h2.mt-os-card-grid__title Servicios urbanos
          p.mt-os-card-grid__text Ofrecemos soluciones de transporte local con diferentes tipos de vehículos, según el tipo de carga.
          img(src="public/assets/images/our-services/last-mile.svg", alt="Ultima Milla", class="mt-os-hero__logo")
        div.mt-os-card-grid__item
          h2.mt-os-card-grid__title Mercancia consolidada
          p.mt-os-card-grid__text Aprovechamos rutas de retorno para transportar tu carga en modalidad de compensación, optimizando costos y recursos.
          img(src="public/assets/images/our-services/charge.svg", alt="Cargo", class="mt-os-hero__logo")
        div.mt-os-card-grid__item
          h2.mt-os-card-grid__title Sector Construcción
          p.mt-os-card-grid__text Disponemos de volquetas adecuadas para transportar sedimentos en proyectos urbanos, industriales o ambientales.
          img(src="public/assets/images/our-services/construction-sector.svg", alt="Sector Construccion", class="mt-os-hero__logo")
    include components/calltoaction/_index
