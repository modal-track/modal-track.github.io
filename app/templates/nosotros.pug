extends _template

block variables
  -var varTitle = "Sobre nosotros"
  -var varDescription = "Descripción de ModalTrack."
  -var varAuthor = "Kevin Prado"

block content
  .mt-main-content.mt-content--our-company
    .mt-our-company__group
      .mt-our-company__group-item
        div.mt-main-container_oc
          h1.mt-oc-title Nuestra compañía
          p.mt-oc-description Somos un grupo empresarial 100 % colombiano, nacido con la pasión de transformar cada eslabón de la cadena logística. Conocemos sus retos y creemos firmemente que, con innovación y compromiso, podemos convertirlos en oportunidades. Estamos aquí para impulsar el cambio, construir soluciones y dejar huella en el camino.
          a.mt-btn.mt-hero__btn(href="#") Contáctanos
        img(src="public/assets/images/our-company/hero.jpg", alt="Camión rojo", class="mt-oc-hero__image")
      .mt-main-container_oc
        article.mt-oc-achievements
          section
            h2.mt-oc-achievements__subtitle Misión
            p.mt-oc-achievements__subtitle-text Somos una compañía especializada en el transporte integral de contenedores, carga suelta y consolidada, así como en la gestión logística de operaciones para el cargue, transporte y descargue de todo tipo de mercancías. Nos destacamos como líderes en el transporte de carga refrigerada, garantizando condiciones óptimas y controladas para productos sensibles.
            p.mt-oc-achievements__subtitle-text Ofrecemos a nuestros clientes una red de distribución segura, eficiente y oportuna, respaldada por altos estándares de calidad, el desarrollo continuo de tecnología de punta y una sólida red de proveedores y aliados estratégicos.
            p.mt-oc-achievements__subtitle-text Trabajamos constantemente en la mejora de nuestros procesos mediante soluciones basadas en inteligencia artificial, buscando optimizar tiempos, reducir costos y elevar la experiencia de nuestros clientes.
          section
            h2.mt-oc-achievements__subtitle Visión
            p.mt-oc-achievements__subtitle-text Ser reconocidos como la empresa líder en soluciones logísticas integrales en América Latina, destacándonos por la excelencia en el transporte de carga —especialmente refrigerada—, la innovación tecnológica y el uso de inteligencia artificial para optimizar procesos, garantizar eficiencia operativa y superar las expectativas de nuestros clientes.
            p.mt-oc-achievements__subtitle-text Aspiramos a transformar la logística en una experiencia ágil, segura y sostenible, siendo un referente en calidad, cumplimiento y transformación digital en el sector.
    include components/calltoaction/_index
    section.mt-oc-values
      h2.mt-oc-values__title Principios organizacionales
      div.mt-oc-values__group
        article.mt-oc-values__item
          button.mt-oc-values__item-subtitle Eficiencia Operativa
          div.mt-oc-values__item-content
            p.mt-oc-values__item-text Buscar constantemente la optimización de procesos y recursos para ofrecer servicios de carga ágiles y rentables.
        article.mt-oc-values__item
          button.mt-oc-values__item-subtitle Compromiso con la Seguridad
          div.mt-oc-values__item-content
            p.mt-oc-values__item-text Priorizar la seguridad de los trabajadores, la carga y el público en general, siguiendo rigurosos estándares y procedimientos.
        article.mt-oc-values__item
          button.mt-oc-values__item-subtitle Innovación Tecnológica
          div.mt-oc-values__item-content
            p.mt-oc-values__item-text Adoptar y desarrollar tecnologías de vanguardia para mejorar la gestión logística, el rastreo de carga y la comunicación con clientes.
        article.mt-oc-values__item
          button.mt-oc-values__item-subtitle Sostenibilidad Ambiental
          div.mt-oc-values__item-content
            p.mt-oc-values__item-text Integrar prácticas y tecnologías que minimicen el impacto ambiental, promoviendo la responsabilidad ecológica en cada operación.
        article.mt-oc-values__item
          button.mt-oc-values__item-subtitle Cultura de Servicio al Cliente
          div.mt-oc-values__item-content
            p.mt-oc-values__item-text Mantener un compromiso inquebrantable con la satisfacción del cliente, ofreciendo atención personalizada y soluciones adaptadas a sus necesidades.
        article.mt-oc-values__item
          button.mt-oc-values__item-subtitle Desarrollo y Crecimiento del Personal
          div.mt-oc-values__item-content
            p.mt-oc-values__item-text Fomentar un ambiente de aprendizaje continuo y desarrollo profesional, reconociendo y promoviendo el talento interno.
  script(src="/public/scripts/script_our-company.js")
